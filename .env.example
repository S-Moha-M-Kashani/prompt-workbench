# Copy to .env and fill in your values. Never commit .env.
#
# The API key can also be pasted into the app's sidebar instead, where it stays
# in that browser session only. Either way it is passed explicitly into a
# provider client and never written into process-global state.

# Required for generation, manual testing, and the provider judge.
PROVIDER_API_KEY=your_api_key_here

# Any OpenAI-compatible endpoint. Defaults to OpenRouter when unset.
PROVIDER_BASE_URL=https://openrouter.ai/api/v1

# Which catalog model the sidebar starts on.
DEFAULT_MODEL=openai/gpt-5-mini

# The local Codex CLI judge needs no variable here: it uses this machine's own
# `codex` login, and is deliberately never given PROVIDER_API_KEY.
